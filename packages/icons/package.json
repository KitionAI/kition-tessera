{
  "name": "@kition/tessera-icons",
  "version": "0.1.0",
  "description": "Tessera Icons: Kition's icon set for kit editors, engines, and hosts. Every icon is a list of SVG path strings, so React, a canvas Path2D, and Rust draw the same shapes.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./registry": "./src/registry.ts",
    "./kit/*": "./kit/*"
  },
  "files": [
    "src",
    "kit",
    "icons.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide": "1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "sideEffects": false
}
