{
  "name": "@kition/tessera-icons",
  "version": "0.1.0",
  "description": "Tessera Icons: Kition's icon set for kit editors, engines, and hosts. Every icon is a list of SVG path strings, so React, a canvas Path2D, and Rust draw the same shapes.",
  "license": "Apache-2.0",
  "homepage": "https://tessera.kition.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KitionAI/kition-tessera.git",
    "directory": "packages/icons"
  },
  "bugs": "https://github.com/KitionAI/kition-tessera/issues",
  "keywords": [
    "icons",
    "svg",
    "react",
    "canvas",
    "design-system",
    "kition",
    "tessera"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.ts",
    "./registry": "./src/registry.ts",
    "./kit/*": "./kit/*"
  },
  "files": [
    "dist",
    "kit",
    "icons.json",
    "keywords.json",
    "NOTICE",
    "LICENSE",
    "LICENSE-lucide",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && node ../../scripts/build-packages.mjs icons",
    "check": "node scripts/build.mjs --check",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide": "1.55.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/src/index.d.ts",
        "default": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/types/src/react.d.ts",
        "default": "./dist/react.js"
      },
      "./registry": {
        "types": "./dist/types/src/registry.d.ts",
        "default": "./dist/registry.js"
      },
      "./kit/*": "./kit/*"
    }
  },
  "//files": "Checkout exports use TypeScript source; pnpm pack applies publishConfig.exports so npm consumers load compiled JavaScript and declarations from dist.",
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts"
}
