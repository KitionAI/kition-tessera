{
  "name": "kition-tessera",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm build:tokens && pnpm build:icons",
    "build:tokens": "node packages/tokens/scripts/build.mjs",
    "build:icons": "node packages/icons/scripts/build.mjs",
    "check": "pnpm check:tokens && pnpm check:icons && pnpm typecheck && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:tokens": "node packages/tokens/scripts/build.mjs --check",
    "check:icons": "node packages/icons/scripts/build.mjs --check",
    "check:consumers": "node scripts/check-consumers.mjs",
    "usage:lucide": "node scripts/lucide-usage.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "lucide-react": "1.55.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "specificity": "^1.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^2.1.0"
  }
}
