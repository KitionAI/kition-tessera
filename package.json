{
  "name": "kition-tessera",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm build:tokens && pnpm build:icons && pnpm build:packages",
    "build:tokens": "node packages/tokens/scripts/build.mjs",
    "build:icons": "node packages/icons/scripts/build.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "check": "pnpm check:lockfile && pnpm check:tokens && pnpm check:icons && pnpm check:node-icons && pnpm check:docs && pnpm typecheck && pnpm test && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "check:tokens": "node packages/tokens/scripts/build.mjs --check",
    "check:icons": "node packages/icons/scripts/build.mjs --check",
    "check:consumers": "node scripts/check-consumers.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "release:dry": "pnpm check:pack",
    "release": "pnpm check && pnpm check:pack && pnpm --filter \"./packages/*\" publish --access public",
    "check:docs": "node site/scripts/component-api.mjs --check && node --no-warnings site/scripts/docs.mjs --check",
    "build:docs": "node site/scripts/component-api.mjs && node --no-warnings site/scripts/docs.mjs",
    "dev": "pnpm --filter @kition/tessera-site dev",
    "build:site": "pnpm --filter @kition/tessera-site build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "check:node-icons": "node --no-warnings scripts/check-node-icons.mjs",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "specificity": "^1.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^2.1.0"
  }
}
